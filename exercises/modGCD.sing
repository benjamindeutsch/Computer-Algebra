LIB "polylib.lib"; //for content

proc crt(int r1, int r2, int m1, int m2){
    list result = extgcd(m1,m2);
    if(result[1] != 1){
        print(string(m1) + " and " + string(m2) + " are not coprime!");
        return (0);
    }

    //a*m1+b*m2=1 => a is the multiplicative inverse of m1 modulo m2;
    int c  = result[2];
    int r1' = r1 % m1;
    int sigma = ((r2-r1')*c) % m2;
    return (r1'+sigma*m1);
}

//get a list of coefficients of size n
proc get_coeff_list(poly f, int n){
    list result = list();
    matrix m = coeffs(f,var(1));
    int i;
    for(i = 1; i <= n; i++){
        if(size(m) < i) {
            result[i] = 0;
        }else{
            result[i] = int(m[i,1]);
        }
    }
    return (result);
}

proc crtPoly(poly f, poly g, int m, int n){
    int s = max(deg(f),deg(g))+1;
    list fcoeffs = get_coeff_list(f,s);
    list gcoeffs = get_coeff_list(g,s);
    
    int i, c;
    poly result = 0;
    for(i = 1; i <= s; i++){
        c = crt(fcoeffs[i],gcoeffs[i],m,n);
        result = result + c * x^(i-1);
    }
    return (result);
}

proc abs(int n){
    if(n<0){
        return ((-1) * n);
    }
    return (n);
}

proc second_norm(poly f) {
    matrix m = coeffs(f,var(1));
    int i;
    int sum = 0;
    for(i = 1; i <= size(m); i++) {
        sum = sum + int(m[i,1])^2;
    }
    //find the (rounded up) square root of the sum
    i = 1;
    while(i^2 < sum){
        i = i + 1;
    }
    return (i);
}

proc laundau_mignotte_bound(poly a, poly b) {
    int m = ord(a);
    int n = ord(b);
    int am = int(leadcoef(a));
    int bn = int(leadcoef(b));
    return (2^min(m,n)
            *gcd(am,bn)
            *min(second_norm(a) div abs(am), second_norm(b) div abs(bn)));
}

proc next_prime(int x) {
    int curr = prime(x);
    int next = curr;
    int i = x;
    while(next == curr){
        i = i + 2;
        next = prime(i);
    }
    return (next);
}

proc next_prime_not_dividing(int curr, int d){
    int p = next_prime(curr);
    while(gcd(p,d) != 1) {
        p = next_prime(p);
    }
    return (p);
}

proc modGCD(poly a, poly b){
    //Step 1
    int d = int(gcd(leadcoef(a),leadcoef(b)));
    int M = laundau_mignotte_bound(a,b);
    poly g, gp_lifted;

    while(1){
        //Step 2
        int p = next_prime_not_dividing(2,d);

        ring RP = p, (x), lp;
        poly cp = gcd(imap(R,a),imap(R,b));
        poly gp = (d % p) * cp;

        //Step 3
        setring R;
        g = imap(RP,gp);
        int P = p;
        if(deg(g) == 0) {
            return (1);
        }

        //Step 4
        while(P <= M) {
            p = next_prime_not_dividing(p,d);

            ring RP = p, (x), lp;
            poly cp = gcd(imap(R,a),imap(R,b));
            poly gp = (d % p) * cp;

            setring R;
            gp_lifted = imap(RP,gp);

            if(deg(gp_lifted) < deg(g)) {
                //Step 3
                if(deg(gp_lifted) == 0) {
                    return (1);
                }
                P = p;
                g = gp_lifted;
            }else{
                if(deg(gp_lifted) == deg(g)) {
                    g = crtPoly(g,gp_lifted,P,p);
                    P = P * p;
                }
            }
        }
        //Step 5
        g = g / content(g);
        if(reduce(a, g) == 0 && reduce(b, g) == 0){
            return (g);
        }
    }
}

proc my_test(poly f, poly g){
    print("-----------------modGCD-----------------");
    print("f: " + string(f) + "; g: " + string(g));
    poly result = modGCD(f,g);
    poly actual = gcd(f,g);
    print("result: " + string(result));
    print("actual: " + string(actual));
}

ring R = 0, (x), lp;

my_test(x3+3x2-4, x3+4x2+x-6);
my_test(2x2-6x-8, 3x3-4x2-5x+2);

quit;