ring R = 0, (x), lp;

poly a1 = x7-x6-x5+x4-x3+x2+x-1;
poly a2 = gcd(a1,diff(a1,x));
print("a2:" + string(a2));
poly c1 = a1/a2;
print("c1:" + string(c1));
poly a3 = gcd(a2,diff(a2,x));
print("a3:" + string(a3));
poly c2 = a2/a3;
print("c2:" + string(c2));
poly b1 = c1/c2;
print("b1:" + string(b1));

poly a4 = gcd(a3,diff(a3,x));
print("a4:" + string(a4));
poly c3 = a3/a4;
print("c3:" + string(c3));
poly b2 = c2/c3;
print("b2:" + string(b2));

poly a5 = gcd(a4,diff(a4,x));
print("a5:" + string(a5));
poly c4 = a4/a5;
print("c4:" + string(c4));
poly b3 = c3/c4;
print("b3:" + string(b3));

poly a6 = gcd(a5,diff(a5,x));
print("a6:" + string(a6));
poly c5 = a5/a6;
print("c5:" + string(c5));
poly b4 = c4/c5;
print("b4:" + string(b4));

poly f = (x2+1)*(x+1)^2*(x-1)^3;
f;

quit;